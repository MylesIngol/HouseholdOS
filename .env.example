# Copy this file to .env and fill in your Supabase project's values.
# Find both in the Supabase dashboard: Project Settings -> API Keys.
#
# EXPO_PUBLIC_SUPABASE_URL is your project's URL, e.g. https://xxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the "Publishable key" (sb_publishable_...),
# NOT the secret key. Only client-safe values belong here — never commit a
# secret/service-role key to this file or anywhere else in the repo.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
