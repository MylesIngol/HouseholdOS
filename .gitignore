# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — only .env.example is committed; real values (Supabase URL/key)
# stay local. The publishable key is technically client-safe to expose, but
# keeping .env out of git is still good hygiene and leaves room for anything
# else that lands in it later.
.env
.env*.local

# Supabase CLI local dev artifacts (not used yet, but harmless to pre-ignore)
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
